# Copie para .env (usado por `npm run dev:server`, `npm start` e `npm run db:seed`).
# No Railway, configure em Variables APENAS: ADMIN_PASSWORD, JWT_SECRET, API_TOKEN e PUBLIC_BASE_URL.
# Nunca versione o .env.
ADMIN_PASSWORD="troque-esta-senha"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cole-aqui-um-valor-aleatorio-de-64-caracteres"
# Opcional: token para integrações externas (Authorization: Bearer <token>), mín. 16 caracteres
API_TOKEN=""
# URL pública das URLs curtas e dos QR codes (ex.: https://go.meudominio.com). Vazio = origem da requisição.
PUBLIC_BASE_URL=""
# SOMENTE LOCAL. Não copie para o Railway: lá o banco fica automaticamente no volume
# (<mount path>/qr.db) e o servidor recusa iniciar se o caminho estiver fora dele.
DATABASE_PATH="./data/qr.db"
# SOMENTE LOCAL. O Railway define a porta sozinho.
PORT=3000
