{
  "name": "qr-dinamico",
  "version": "1.0.0",
  "description": "Gerenciador de QR codes dinâmicos com analytics (Node + Hono + SQLite, deploy no Railway)",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/main.js",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.app.json && tsc -p tsconfig.test.json",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "ua-parser-js": "^1.0.41",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "~4.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
